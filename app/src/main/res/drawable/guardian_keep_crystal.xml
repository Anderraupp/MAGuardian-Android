<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#335AAE83">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="#DFEAE3" />
                    <stroke android:width="1dp" android:color="#A9C1B2" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape>
                    <gradient android:angle="270" android:startColor="#BAEFD6" android:endColor="#6ACD98" />
                    <stroke android:width="1dp" android:color="#3A9567" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <gradient android:angle="270" android:startColor="#DDFEF0" android:centerColor="#9DEAC4" android:endColor="#78D8A7" />
                    <stroke android:width="1dp" android:color="#53B485" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
