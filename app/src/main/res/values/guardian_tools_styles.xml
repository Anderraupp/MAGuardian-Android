<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GuardianToolAction" parent="GuardianSecondary">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:padding">8dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">16sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:tag">guardian_tools_row</item>
    </style>
    <style name="GuardianToolsSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:textColor">?attr/guardian_ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:tag">guardian_tools_row</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="switchMinWidth">40dp</item>
        <item name="switchPadding">8dp</item>
        <item name="thumbTint">@color/guardian_switch_thumb</item>
        <item name="trackTint">@color/guardian_switch_track</item>
    </style>
    <style name="GuardianToolsGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/guardian_compact_card</item>
        <item name="android:padding">2dp</item>
    </style>
    <style name="GuardianToolsHeading" parent="GuardianSection">
        <item name="android:textSize">18sp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>
    <style name="GuardianToolsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">?attr/guardian_muted</item>
        <item name="android:alpha">0.3</item>
    </style>
</resources>
