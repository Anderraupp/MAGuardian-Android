<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Test-only visual direction. Existing overlay/service palettes stay unchanged. -->
    <color name="guardian_paper">#F3EFE9</color>
    <color name="guardian_card">#FBF9F5</color>
    <color name="guardian_ink">#272523</color>
    <color name="guardian_muted">#68615B</color>
    <color name="guardian_line">#DED6CD</color>
    <color name="guardian_red">#B94235</color>
    <color name="guardian_red_deep">#8F2F27</color>
    <color name="guardian_wash">#F1DFD8</color>
    <color name="guardian_success">#3F633F</color>
    <color name="guardian_button_bg">#272523</color>
    <color name="guardian_button_text">#FFFFFF</color>
    <color name="guardian_danger">#A62D25</color>
    <color name="guardian_warning">#89591D</color>
    <bool name="guardian_light_bars">true</bool>
    <string name="guardian_support_email" translatable="false">contato@meacelulareseacessorios.com.br</string>
    <string name="guardian_support_whatsapp" translatable="false">5545998487232</string>
    <string name="guardian_support_whatsapp_display" translatable="false">+55 (45) 99848-7232</string>
    <style name="Theme.MAGuardian.Preview" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="guardian_primary_start">?attr/guardian_button_bg</item>
        <item name="guardian_primary_middle">?attr/guardian_button_bg</item>
        <item name="guardian_primary_end">?attr/guardian_button_bg</item>
        <item name="guardian_protection_surface">?attr/guardian_card</item>
        <item name="guardian_protection_border">?attr/guardian_line</item>
        <item name="guardian_paper">@color/guardian_paper</item>
        <item name="guardian_card">@color/guardian_card</item>
        <item name="guardian_ink">@color/guardian_ink</item>
        <item name="guardian_muted">@color/guardian_muted</item>
        <item name="guardian_line">@color/guardian_line</item>
        <item name="guardian_red">@color/guardian_red</item>
        <item name="guardian_red_deep">@color/guardian_red_deep</item>
        <item name="guardian_wash">@color/guardian_wash</item>
        <item name="guardian_button_bg">@color/guardian_button_bg</item>
        <item name="guardian_button_text">@color/guardian_button_text</item>
        <item name="guardian_success">@color/guardian_success</item>
        <item name="guardian_danger">@color/guardian_danger</item>
        <item name="guardian_warning">@color/guardian_warning</item>
        <item name="colorPrimary">?attr/guardian_button_bg</item>
        <item name="colorPrimaryVariant">?attr/guardian_button_bg</item>
        <item name="colorOnPrimary">?attr/guardian_button_text</item>
        <item name="colorSecondary">?attr/guardian_button_bg</item>
        <item name="colorSecondaryVariant">?attr/guardian_button_bg</item>
        <item name="colorOnSecondary">?attr/guardian_button_text</item>
        <item name="colorSurface">?attr/guardian_card</item>
        <item name="colorOnSurface">?attr/guardian_ink</item>
        <item name="colorError">?attr/guardian_danger</item>
        <item name="colorControlActivated">?attr/guardian_button_bg</item>
        <item name="colorControlNormal">?attr/guardian_muted</item>
        <item name="android:colorAccent">?attr/guardian_button_bg</item>
        <item name="android:colorBackground">?attr/guardian_paper</item>
        <item name="android:colorForeground">?attr/guardian_ink</item>
        <item name="android:windowBackground">?attr/guardian_paper</item>
        <!-- Material 1.11 reads these as ColorStateList resource IDs before
             applying the navigation view's explicit tint. Literal color attrs
             resolve with resourceId=0 and crash during menu inflation. -->
        <item name="android:textColorPrimary">@color/guardian_text_primary</item>
        <item name="android:textColorSecondary">@color/guardian_text_secondary</item>
        <item name="android:textColorHint">@color/guardian_text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/guardian_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/guardian_light_bars</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="materialButtonStyle">@style/Widget.AppCompat.Button</item>
        <item name="viewInflaterClass">androidx.appcompat.app.AppCompatViewInflater</item>
    </style>
    <style name="GuardianText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/guardian_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="GuardianCaption" parent="GuardianText">
        <item name="android:textColor">?attr/guardian_muted</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="GuardianHeading" parent="GuardianText">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="GuardianCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/guardian_card</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>
    <style name="GuardianButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/guardian_button_text</item>
        <item name="android:background">@drawable/guardian_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="GuardianSecondary" parent="GuardianButton">
        <item name="android:textColor">?attr/guardian_ink</item>
        <item name="android:background">@drawable/guardian_secondary</item>
    </style>
    <style name="GuardianTool" parent="GuardianSecondary">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">110dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">110dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minLines">3</item>
        <item name="android:maxLines">3</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">?attr/guardian_button_bg</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="GuardianMetricCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">@drawable/guardian_card</item>
    </style>
    <style name="GuardianMetricValue" parent="GuardianText">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
    </style>
    <style name="GuardianMetricLabel" parent="GuardianCaption">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="GuardianMetric" parent="GuardianText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="GuardianFooter" parent="GuardianSecondary">
        <item name="android:textSize">12sp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">?attr/guardian_muted</item>
    </style>
    <style name="GuardianNavLabel">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Theme.MAGuardian.Palette.Original" parent="Theme.MAGuardian.Preview">
        <item name="guardian_paper">#090909</item>
