        <item name="guardian_primary_start">#FFE6A4</item>
        <item name="guardian_primary_middle">#F9C65C</item>
        <item name="guardian_primary_end">#EDAD36</item>
        <item name="guardian_button_text">#201606</item>
        <item name="guardian_success">#79D39A</item>
        <item name="guardian_danger">#FF8A80</item>
