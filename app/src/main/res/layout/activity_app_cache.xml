<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/guardian_paper">
    <ScrollView android:id="@+id/guardianScrollContent" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <Button android:id="@+id/btnCacheBack" style="@style/GuardianSecondary" android:text="← Voltar para a tela principal" />
        <TextView style="@style/GuardianHeading" android:text="Cache por aplicativo" android:textSize="28sp" android:layout_marginTop="24dp" />
        <TextView style="@style/GuardianText" android:text="Revise os arquivos temporários e abra as configurações de cada aplicativo para gerenciá-los." android:layout_marginBottom="24dp" />
        <LinearLayout style="@style/GuardianCard">
            <TextView style="@style/GuardianCaption" android:text="TOTAL CONSULTADO" android:textColor="?attr/guardian_button_bg" android:letterSpacing="0.1" />
            <TextView android:id="@+id/tvAppCacheTotal" style="@style/GuardianHeading" android:text="Consultando…" android:textSize="30sp" android:layout_marginTop="12dp" />
            <TextView android:id="@+id/tvAppCacheSummary" style="@style/GuardianCaption" android:text="Os tamanhos dependem das informações disponibilizadas pelo Android." android:accessibilityLiveRegion="polite" />
            <ProgressBar android:id="@+id/progressAppCache" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" />
        </LinearLayout>
        <Button android:id="@+id/btnCachePermission" style="@style/GuardianButton" android:text="Autorizar acesso de uso" android:visibility="gone" android:layout_marginBottom="14dp" />
        <TextView style="@style/GuardianHeading" android:text="Cache por app" />
        <LinearLayout android:id="@+id/llAppCaches" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <LinearLayout style="@style/GuardianCard">
            <TextView style="@style/GuardianHeading" android:text="O que o Android permite" />
            <TextView style="@style/GuardianText" android:text="Use Abrir para acessar o armazenamento de um app. Limpar tudo abre uma opção do próprio Android e pode exigir confirmação.\n\nAo retornar, os tamanhos são consultados novamente. Se o Android ainda mostrar o valor anterior, aguarde alguns instantes e toque em Atualizar valores. A consulta não força nem simula a limpeza de outros aplicativos." />
        </LinearLayout>
        <Button android:id="@+id/btnCacheRefresh" style="@style/GuardianSecondary" android:text="Atualizar valores" android:layout_marginBottom="12dp" />
        <Button android:id="@+id/btnCacheCleanAll" style="@style/GuardianButton" android:text="Limpar tudo pelo Android" android:layout_marginBottom="12dp" />
        <TextView style="@style/GuardianCaption" android:text="Arquivos pessoais não são removidos por esta tela. A limpeza e os números apresentados dependem do sistema." />
    </LinearLayout>
    </ScrollView>
    <include layout="@layout/guardian_bottom_nav" />
</LinearLayout>
