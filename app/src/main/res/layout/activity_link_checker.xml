<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/guardian_paper">
    <ScrollView android:id="@+id/guardianScrollContent" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/btnBack" style="@style/GuardianText" android:text="← Voltar"
            android:minHeight="48dp" android:gravity="center_vertical" android:clickable="true"
            android:focusable="true" android:background="?android:attr/selectableItemBackground" />
        <TextView style="@style/GuardianHeading" android:text="Conferir um link" android:textSize="28sp" android:layout_marginTop="20dp" />
        <TextView style="@style/GuardianText" android:text="Veja sinais que merecem atenção antes de abrir um endereço recebido por mensagem." android:layout_marginBottom="24dp" />
        <LinearLayout style="@style/GuardianCard">
            <TextView style="@style/GuardianText" android:text="Endereço do link" android:textStyle="bold" android:layout_marginBottom="12dp" />
            <EditText android:id="@+id/etUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="60dp" android:inputType="textUri" android:hint="https://exemplo.com/"
                android:textColor="?attr/guardian_ink" android:textColorHint="?attr/guardian_muted"
                android:textSize="15sp" android:background="@drawable/guardian_card" android:padding="14dp" android:maxLines="4" />
            <Button android:id="@+id/btnPaste" style="@style/GuardianSecondary" android:text="Colar link" android:layout_marginTop="12dp" />
            <Button android:id="@+id/btnCheck" style="@style/GuardianButton" android:text="Conferir link" android:layout_marginTop="10dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cardResult" style="@style/GuardianCard" android:visibility="gone">
            <TextView android:id="@+id/tvVerdictIcon" style="@style/GuardianText" android:textSize="24sp" />
            <TextView android:id="@+id/tvVerdict" style="@style/GuardianHeading" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/tvScore" style="@style/GuardianCaption" android:layout_marginBottom="14dp" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="8dp" android:background="?attr/guardian_line" android:layout_marginBottom="16dp">
                <View android:id="@+id/viewScoreBar" android:layout_width="0dp" android:layout_height="8dp" android:background="?attr/guardian_red" />
            </FrameLayout>
            <TextView android:id="@+id/tvReasonsLabel" style="@style/GuardianText" android:text="Motivos identificados" android:textStyle="bold" android:visibility="gone" />
            <LinearLayout android:id="@+id/llReasons" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
        <LinearLayout style="@style/GuardianCard">
            <TextView style="@style/GuardianText" android:text="Confira antes de acessar:" android:textStyle="bold" />
            <TextView style="@style/GuardianCaption" android:text="Cole o link e deixe o M&amp;A Guardian analisar possíveis sinais de risco antes de você continuar." android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
    <include layout="@layout/guardian_bottom_nav" />
</LinearLayout>
