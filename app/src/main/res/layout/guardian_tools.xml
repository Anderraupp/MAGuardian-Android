<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guardianToolsContent" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
    <Button android:id="@+id/btnToolsBack" style="@style/GuardianToolbar" android:text="←  Ferramentas e ajustes" />
    <TextView style="@style/GuardianSection" android:text="Ferramentas" />
    <Button android:id="@+id/btnLinkChecker" style="@style/GuardianSetting" android:text="Verificar link suspeito"
        android:drawableStart="@drawable/guardian_ic_link" />
    <Button android:id="@+id/btnAppCache" style="@style/GuardianSetting" android:text="Cache por aplicativo"
        android:drawableStart="@drawable/guardian_ic_cache" />
    <TextView style="@style/GuardianSection" android:text="Ligações" />
    <LinearLayout android:id="@+id/cardBlockTelemarketing" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchBlockTelemarketing" style="@style/GuardianSwitch"
            android:text="Bloquear telemarketing" app:thumbTint="?attr/guardian_red" />
        <TextView android:id="@+id/tvBlockTelemarketingStatus" style="@style/GuardianCaption" android:layout_marginBottom="8dp" />
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchCallAlerts" style="@style/GuardianSwitch"
        android:text="Alertar ligações suspeitas" app:thumbTint="?attr/guardian_red" />
    <TextView android:id="@+id/tvCallAlertsStatus" style="@style/GuardianCaption" android:layout_marginBottom="8dp" />
    <LinearLayout android:id="@+id/cardReportNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <Button android:id="@+id/btnReportNumber" style="@style/GuardianSetting" android:text="Reportar ou bloquear número" android:drawableStart="@drawable/guardian_ic_phone" />
    </LinearLayout>
    <TextView style="@style/GuardianSection" android:text="Permissões e manutenção" />
    <LinearLayout android:id="@+id/layoutPermWarning" style="@style/GuardianCard" android:visibility="gone">
        <TextView android:id="@+id/tvPermWarning" style="@style/GuardianText" />
        <Button android:id="@+id/btnPermissions" style="@style/GuardianSecondary" android:text="Revisar permissões" android:layout_marginTop="8dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/layoutNotifWarning" style="@style/GuardianCard" android:visibility="gone">
        <TextView style="@style/GuardianText" android:text="Ative as notificações para receber os alertas do M&amp;A Guardian." />
        <Button android:id="@+id/btnNotifPermission" style="@style/GuardianSecondary" android:text="Ativar notificações" android:layout_marginTop="8dp" />
    </LinearLayout>
    <Button android:id="@+id/btnToolsPermissions" style="@style/GuardianSetting" android:text="Revisar permissões do aplicativo" />
    <Button android:id="@+id/btnToolsNotifications" style="@style/GuardianSetting" android:text="Ativar ou gerenciar notificações" />
    <Button android:id="@+id/btnUpdateCatalog" style="@style/GuardianSetting" android:text="Atualizar a base de ameaças" />
    <TextView android:id="@+id/tvCatalogSummary" style="@style/GuardianCaption" android:layout_marginBottom="8dp" />
    <Button android:id="@+id/btnCatalogDetails" style="@style/GuardianSetting" android:text="Detalhes da base" />
    <LinearLayout android:id="@+id/layoutCatalogDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/tvCatalogStatus" style="@style/GuardianCaption" android:textIsSelectable="true" />
    </LinearLayout>
    <Button android:id="@+id/btnScanHistory" style="@style/GuardianSetting" android:text="Histórico de análises" />
    <Button android:id="@+id/btnClearThreats" style="@style/GuardianSetting" android:text="Limpar registros de ameaças" />
    <TextView style="@style/GuardianSection" android:text="Aparência" />
    <Button android:id="@+id/btnAppearance" style="@style/GuardianSetting" android:text="Escolher tema" android:drawableStart="@drawable/guardian_ic_designer" />
    <TextView style="@style/GuardianSection" android:text="Privacidade e informações legais" />
    <Button android:id="@+id/btnToolsTerms" style="@style/GuardianSetting" android:text="Termos de uso" />
    <Button android:id="@+id/btnToolsPrivacy" style="@style/GuardianSetting" android:text="Política de privacidade" />
    <Button android:id="@+id/btnRequestDataDeletion" style="@style/GuardianSetting" android:text="Solicitar exclusão de conta e dados" />
    <TextView android:id="@+id/btnCatalogSources" style="@style/GuardianText" android:text="Informações legais"
        android:minHeight="48dp" android:padding="12dp" android:gravity="center_vertical"
        android:background="@drawable/guardian_secondary" android:clickable="true" android:focusable="true" />
    <Button android:id="@+id/btnCatalogAdmin" style="@style/GuardianFooter" android:text="Área do administrador" android:visibility="gone" />
    <!-- Legacy bindings kept for existing cache and call-permission flows, not duplicate destinations. -->
    <Button android:id="@+id/btnCallScanner" style="@style/GuardianSecondary" android:visibility="gone" />
    <Button android:id="@+id/btnCleanCache" style="@style/GuardianSecondary" android:visibility="gone" />
    <Button android:id="@+id/btnLearnAboutGuardian" style="@style/GuardianFooter" android:visibility="gone" />
    <TextView android:id="@+id/tvCacheSize" style="@style/GuardianCaption" android:visibility="gone" />
</LinearLayout>
