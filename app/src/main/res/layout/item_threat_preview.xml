<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/GuardianCard" android:layout_marginTop="16dp" android:background="@drawable/guardian_status">
    <TextView android:id="@+id/tvThreatSeverity" style="@style/GuardianCaption" android:textColor="@color/guardian_red_deep" android:textStyle="bold" />
    <TextView android:id="@+id/tvThreatName" style="@style/GuardianHeading" android:layout_marginTop="10dp" />
    <TextView android:id="@+id/tvThreatPackage" style="@style/GuardianCaption" android:textIsSelectable="true" />
    <TextView android:id="@+id/tvThreatType" style="@style/GuardianText" android:layout_marginTop="14dp" />
    <TextView style="@style/GuardianText" android:text="Revise este aplicativo antes de decidir. Se você o reconhece e deseja continuar usando, escolha Manter. Para solicitar a remoção pelo Android, escolha Desinstalar." android:layout_marginTop="12dp" />
    <Button android:id="@+id/btnKeep" style="@style/GuardianSecondary" android:text="Manter"
        android:background="@drawable/guardian_keep_crystal" android:textColor="#0D5135" android:layout_marginTop="16dp" />
    <Button android:id="@+id/btnUninstall" style="@style/GuardianButton" android:text="Desinstalar"
        android:background="@drawable/guardian_uninstall_crystal" android:textColor="#5B1510" android:layout_marginTop="10dp" />
</LinearLayout>
