<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/guardian_paper">
    <ScrollView android:id="@+id/guardianScrollContent" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="@dimen/guardian_screen_padding">
            <Button android:id="@+id/btnSubscriptionBack" style="@style/GuardianToolbar" android:text="←  Premium" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="104dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/guardian_waves" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <ImageView android:layout_width="80dp" android:layout_height="80dp" android:layout_gravity="center" android:src="@drawable/logo"
                    android:scaleType="fitCenter" android:contentDescription="Logo M&amp;A Guardian" />
            </FrameLayout>
            <TextView style="@style/GuardianPageTitle" android:text="M&amp;A Guardian Pro" android:textSize="24sp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" />
            <TextView style="@style/GuardianCaption" android:text="Mais controle e cuidado com o seu celular" android:gravity="center" android:layout_marginBottom="12dp" />
            <ProgressBar android:id="@+id/progressBilling" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" />
            <TextView android:id="@+id/tvLoadingPlans" style="@style/GuardianCaption" android:text="Consultando a Google Play…" android:gravity="center" />
            <LinearLayout android:id="@+id/layoutContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout style="@style/GuardianCard" android:gravity="center">
                    <TextView android:id="@+id/tvPremiumState" style="@style/GuardianCaption" android:text="PLANO MENSAL" android:gravity="center" />
                    <TextView android:id="@+id/tvMonthlyPrice" style="@style/GuardianHeading" android:text="Consultando preço…" android:textSize="30sp" android:gravity="center" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" android:textColor="?attr/guardian_red" />
                    <TextView android:id="@+id/tvPlayOffer" style="@style/GuardianText" android:gravity="center" android:visibility="gone" />
                    <TextView style="@style/GuardianCaption" android:text="Renovação automática. Cancele pela Google Play." android:gravity="center" android:layout_marginTop="8dp" />
                </LinearLayout>
                <TextView style="@style/GuardianSection" android:text="Tudo incluso na assinatura" android:layout_marginTop="0dp" />
                <LinearLayout style="@style/GuardianCard">
                    <TextView style="@style/GuardianText" android:text="✓  Análise de aplicativos" android:paddingBottom="10dp" />
                    <TextView style="@style/GuardianText" android:text="✓  Monitoramento em tempo real" android:paddingBottom="10dp" />
                    <TextView style="@style/GuardianText" android:text="✓  Revisão de aplicativos sinalizados" android:paddingBottom="10dp" />
                    <TextView style="@style/GuardianText" android:text="✓  Limpeza guiada de cache" android:paddingBottom="10dp" />
                    <TextView style="@style/GuardianText" android:text="✓  Verificação de links" android:paddingBottom="10dp" />
                    <TextView style="@style/GuardianText" android:text="✓  Bloqueio de chamadas indesejadas" android:paddingBottom="10dp" />
                    <TextView style="@style/GuardianText" android:text="✓  Alertas de chamadas suspeitas" android:paddingBottom="10dp" />
                    <TextView style="@style/GuardianText" android:text="✓  Atendimento da equipe" />
                </LinearLayout>
                <Button android:id="@+id/btnSubscribe" style="@style/GuardianButton" android:text="Continuar com Google Play"
                    android:background="@drawable/guardian_subscribe" android:textColor="#FFFFFF" />
                <TextView style="@style/GuardianCaption" android:text="O monitoramento depende das permissões e das condições de execução do Android. A Google Play confirma a oferta e a cobrança antes da compra."
                    android:gravity="center" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" />
                <TextView android:id="@+id/btnRestore" style="@style/GuardianFooter" android:text="Restaurar compra anterior"
                    android:gravity="center" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/tvTerms" style="@style/GuardianFooter" android:text="Termos de uso" android:gravity="center" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/tvPrivacy" style="@style/GuardianFooter" android:text="Privacidade" android:gravity="center" android:clickable="true" android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/guardian_bottom_nav" />
</LinearLayout>
