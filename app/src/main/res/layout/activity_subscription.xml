<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/guardian_paper">
    <ScrollView android:id="@+id/guardianScrollContent" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp">
                <TextView style="@style/GuardianText" android:minHeight="48dp" android:text="Premium"
                    android:gravity="center" android:textColor="?attr/guardian_red" android:textStyle="bold" android:textSize="20sp" />
                <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnSubscriptionBack"
                    android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
                    android:src="@drawable/guardian_ic_back" android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voltar" />
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="84dp" android:clipChildren="false">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/guardian_waves"
                    android:scaleType="fitXY" android:importantForAccessibility="no" />
                <ImageView android:layout_width="112dp" android:layout_height="112dp" android:layout_gravity="center"
                    android:src="@drawable/logo" android:scaleType="fitCenter" android:contentDescription="Logo M&amp;A Guardian" />
            </FrameLayout>
            <TextView style="@style/GuardianPageTitle" android:text="M&amp;A Guardian Pro" android:textSize="24sp"
                android:layout_marginTop="2dp" android:layout_marginBottom="0dp" />
            <TextView style="@style/GuardianCaption" android:text="Mais controle e cuidado com o seu celular"
                android:gravity="center" android:layout_marginBottom="10dp" />
            <LinearLayout android:id="@+id/layoutContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout style="@style/GuardianCard" android:gravity="center" android:padding="10dp" android:layout_marginBottom="10dp">
                    <TextView android:id="@+id/tvPremiumState" style="@style/GuardianCaption" android:text="PLANO MENSAL" android:gravity="center" />
                    <TextView android:id="@+id/tvPlayOffer" style="@style/GuardianText" android:gravity="center" android:visibility="gone" />
                    <TextView android:id="@+id/tvMonthlyPrice" style="@style/GuardianHeading" android:text="R$ 9,99"
                        android:textSize="34sp" android:lineSpacingExtra="0dp" android:gravity="center"
                        android:layout_marginBottom="0dp" android:textColor="?attr/guardian_red" />
                    <TextView android:id="@+id/tvPriceReference" style="@style/GuardianCaption"
                        android:text="Teste 7 dias grátis" android:textStyle="bold" android:textColor="?attr/guardian_ink"
                        android:gravity="center" android:visibility="gone" />
                </LinearLayout>
                <TextView style="@style/GuardianSection" android:text="Tudo incluso na assinatura" android:layout_marginTop="0dp" android:layout_marginBottom="6dp" />
                <include layout="@layout/guardian_premium_benefits" />
                <Button android:id="@+id/btnSubscribe" style="@style/GuardianButton" android:text="Consultar oferta na Google Play"
                    android:background="@drawable/guardian_subscribe" android:textColor="#FFFFFF"
                    android:layout_marginTop="8dp" android:layout_marginBottom="6dp" />
                <ProgressBar android:id="@+id/progressBilling" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center_horizontal" />
                <LinearLayout android:id="@+id/subscriptionFooter" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/tvSubscriptionFooterPrice" style="@style/GuardianCaption"
                    android:text="R$ 9,99 por mês." android:textSize="14sp"
                    android:textColor="?attr/guardian_ink" android:gravity="center" android:lineSpacingExtra="0dp" />
                <TextView android:id="@+id/tvSubscriptionFooterBilling" style="@style/GuardianCaption"
                    android:text="Assinatura pela Google Play" android:textSize="14sp"
                    android:textColor="?attr/guardian_ink" android:gravity="center" android:lineSpacingExtra="0dp" />
                <LinearLayout android:id="@+id/subscriptionLegalLinks" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:gravity="center" android:baselineAligned="false">
                    <TextView android:id="@+id/tvPrivacy" style="@style/GuardianFooter" android:layout_width="wrap_content"
                        android:text="Privacidade" android:gravity="top|center_horizontal" android:padding="4dp"
                        android:clickable="true" android:focusable="true" />
                </LinearLayout>
                </LinearLayout>
                <TextView style="@style/GuardianCaption" android:text="Renovação automática. Cancele pela Google Play."
                    android:gravity="center" />
                <TextView android:id="@+id/tvLoadingPlans" style="@style/GuardianCaption"
                    android:text="A oferta e a contratação serão confirmadas pela Google Play." android:gravity="center" />
                <TextView android:id="@+id/btnRestore" style="@style/GuardianFooter" android:text="Restaurar compra anterior"
                    android:gravity="center" android:clickable="true" android:focusable="true" />
                <TextView style="@style/GuardianCaption" android:text="O monitoramento depende das permissões e das condições de execução do Android."
                    android:gravity="center" android:layout_marginBottom="8dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/guardian_bottom_nav" />
</LinearLayout>
