<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/guardian_paper">
    <ScrollView android:id="@+id/guardianScrollContent" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="24dp">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/logo"
                android:scaleType="fitCenter" android:contentDescription="Logo M&amp;A Guardian" android:layout_marginEnd="8dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvAppTitle" style="@style/GuardianHeading" android:text="M&amp;A Guardian"
                    android:layout_marginBottom="0dp" android:minHeight="48dp" android:gravity="center_vertical" />
                <TextView style="@style/GuardianCaption" android:text="Proteção e ferramentas" />
            </LinearLayout>
            <ImageButton android:id="@+id/btnAppearance" android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/guardian_ic_theme" android:tint="@color/guardian_ink"
                android:background="@drawable/guardian_secondary" android:padding="12dp"
                android:contentDescription="Escolher tema claro ou escuro" app:backgroundTint="@null" />
        </LinearLayout>
        <TextView style="@style/GuardianCaption" android:text="VISÃO GERAL" android:textColor="@color/guardian_red_deep" android:letterSpacing="0.12" />
        <TextView style="@style/GuardianHeading" android:text="Seu Android, sob controle." android:textSize="26sp" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" />

        <LinearLayout android:id="@+id/layoutPermWarning" style="@style/GuardianCard" android:visibility="gone" android:background="@drawable/guardian_status">
            <TextView android:id="@+id/tvPermWarning" style="@style/GuardianText" />
            <Button android:id="@+id/btnPermissions" style="@style/GuardianButton" android:text="Revisar permissões" android:layout_marginTop="10dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/layoutNotifWarning" style="@style/GuardianCard" android:visibility="gone" android:background="@drawable/guardian_status">
            <TextView style="@style/GuardianText" android:text="Ative as notificações para receber os alertas do M&amp;A Guardian." />
            <Button android:id="@+id/btnNotifPermission" style="@style/GuardianButton" android:text="Ativar notificações" android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/cardStatus" style="@style/GuardianCard" android:background="@drawable/guardian_status" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/ivShield" android:layout_width="40dp" android:layout_height="48dp"
                    android:src="@drawable/ic_shield_check" android:tint="@color/guardian_red_deep" android:contentDescription="Estado da proteção" android:layout_marginEnd="16dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/GuardianCaption" android:text="PROTEÇÃO DO APARELHO" />
                    <TextView android:id="@+id/tvStatus" style="@style/GuardianHeading" android:text="Verificando estado" android:textSize="21sp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvStatusBadge" style="@style/GuardianCaption" android:text="" android:visibility="gone" />
                </LinearLayout>
                <TextView android:id="@+id/btnToggle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:maxWidth="100dp" android:gravity="center" android:padding="10dp"
                    android:text="Ativar" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/guardian_ink"
                    android:background="@drawable/guardian_secondary" android:clickable="true" android:focusable="true" />
            </LinearLayout>
            <TextView android:id="@+id/tvStatusDesc" style="@style/GuardianText" android:text="Consultando o estado da proteção." android:layout_marginTop="12dp" />
            <!-- Kept for the existing state binding, not presented as a security guarantee. -->
            <TextView android:id="@+id/tvSecurityRate" style="@style/GuardianCaption" android:visibility="gone" />
            <TextView android:id="@+id/tvScansClean" style="@style/GuardianCaption" android:visibility="gone" />
        </LinearLayout>
        <Button android:id="@+id/btnScan" style="@style/GuardianButton" android:text="Analisar apps instalados"
            android:drawableStart="@drawable/ic_shield" android:drawableTint="@color/guardian_button_text" android:drawablePadding="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp" android:layout_marginBottom="24dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvTotalFound" style="@style/GuardianMetric" android:text="0" />
                <TextView style="@style/GuardianCaption" android:text="Ameaças\nativas" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvTotalRemoved" style="@style/GuardianMetric" android:text="0" />
                <TextView style="@style/GuardianCaption" android:text="Removidas" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvTotalScans" style="@style/GuardianMetric" android:text="0" />
                <TextView style="@style/GuardianCaption" android:text="Análises" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:orientation="vertical">
                <TextView android:id="@+id/tvLastScan" style="@style/GuardianText" android:text="Nunca" android:textSize="13sp" android:layout_marginBottom="6dp" />
                <TextView style="@style/GuardianCaption" android:text="Última análise" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/GuardianHeading" android:text="Ferramentas" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
            <Button android:id="@+id/btnCleanCache" style="@style/GuardianTool" android:text="Limpar cache" android:drawableTop="@drawable/guardian_ic_cache" android:layout_marginEnd="5dp" />
            <Button android:id="@+id/btnAppCache" style="@style/GuardianTool" android:text="Cache por app" android:drawableTop="@drawable/guardian_ic_app" android:layout_marginStart="5dp" />
        </LinearLayout>
        <TextView android:id="@+id/tvCacheSize" style="@style/GuardianCaption" android:text="Consultando cache…" android:layout_marginBottom="14dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="20dp">
            <Button android:id="@+id/btnLinkChecker" style="@style/GuardianTool" android:text="Conferir um link" android:drawableTop="@drawable/guardian_ic_link" android:layout_marginEnd="5dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="5dp">
                <Button android:id="@+id/btnCallScanner" style="@style/GuardianSecondary" android:minHeight="82dp" android:text="Ativar" android:drawableTop="@drawable/guardian_ic_phone" android:drawablePadding="8dp" />
                <TextView style="@style/GuardianCaption" android:text="Proteção de ligações" android:gravity="center" android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/cardBlockTelemarketing" style="@style/GuardianCard">
            <TextView style="@style/GuardianHeading" android:text="Chamadas e bloqueios" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchBlockTelemarketing"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="Bloquear telemarketing" android:textColor="@color/guardian_ink" android:textSize="14sp"
                app:thumbTint="@color/guardian_red" />
            <TextView android:id="@+id/tvBlockTelemarketingStatus" style="@style/GuardianCaption" android:layout_marginTop="8dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cardReportNumber" style="@style/GuardianCard">
            <TextView style="@style/GuardianText" android:text="Reportar ou bloquear número" android:textStyle="bold" />
            <TextView style="@style/GuardianCaption" android:text="Informe um número que você não quer receber." android:layout_marginTop="4dp" android:layout_marginBottom="12dp" />
            <Button android:id="@+id/btnReportNumber" style="@style/GuardianSecondary" android:text="Informar número" />
        </LinearLayout>

        <LinearLayout style="@style/GuardianCard">
            <TextView style="@style/GuardianHeading" android:text="Atividade recente" />
            <TextView android:id="@+id/tvThreatCount" style="@style/GuardianCaption" android:text="0 registros" />
            <Button android:id="@+id/btnClearThreats" style="@style/GuardianSecondary" android:text="Limpar histórico" android:layout_marginTop="12dp" />
            <LinearLayout android:id="@+id/layoutEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="16dp" android:paddingBottom="8dp">
                <TextView style="@style/GuardianText" android:text="Nenhuma ameaça ativa" android:textStyle="bold" />
                <TextView style="@style/GuardianCaption" android:text="Faça uma análise para verificar os aplicativos instalados." android:layout_marginTop="6dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/layoutThreatsLocked" style="@style/GuardianCard" android:visibility="gone" android:layout_marginTop="14dp" android:background="@drawable/guardian_status">
                <TextView android:id="@+id/tvThreatsLockedCount" style="@style/GuardianText" android:textStyle="bold" />
                <TextView style="@style/GuardianCaption" android:text="A assinatura libera os detalhes dos alertas e as ações disponíveis." android:layout_marginTop="8dp" />
                <Button android:id="@+id/btnUnlockThreats" style="@style/GuardianButton" android:text="Conhecer o Premium" android:layout_marginTop="12dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/llThreats" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout style="@style/GuardianCard">
            <TextView style="@style/GuardianHeading" android:text="Base de ameaças" />
            <TextView android:id="@+id/tvCatalogSummary" style="@style/GuardianCaption" />
            <Button android:id="@+id/btnCatalogDetails" style="@style/GuardianSecondary" android:text="Ver detalhes" android:layout_marginTop="12dp" />
            <Button android:id="@+id/btnUpdateCatalog" style="@style/GuardianButton" android:text="Atualizar base de ameaças" android:layout_marginTop="10dp" />
            <LinearLayout android:id="@+id/layoutCatalogDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingTop="12dp">
                <TextView android:id="@+id/tvCatalogStatus" style="@style/GuardianCaption" android:textIsSelectable="true" />
            </LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/btnCatalogAdmin" style="@style/GuardianFooter" android:text="Área do administrador" android:visibility="gone" />
        <Button android:id="@+id/btnLearnAboutGuardian" style="@style/GuardianFooter" android:text="Conheça o M&amp;A Guardian" android:visibility="gone" />
        <Button android:id="@+id/btnRequestDataDeletion" style="@style/GuardianFooter" android:text="Solicitar exclusão de conta e dados" />
        <TextView android:id="@+id/btnCatalogSources" style="@style/GuardianCaption" android:text="Informações legais"
            android:minHeight="48dp" android:gravity="center" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    </ScrollView>
    <include layout="@layout/guardian_bottom_nav" />
</LinearLayout>
